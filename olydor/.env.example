# ==============================================================================
# Olydor — Variables d'environnement globales (Monorepo)
# ==============================================================================

# --- Backend API (apps/api -> https://api.olydor.app) ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/olydor_db

# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGIN=https://olydor.app,https://www.olydor.app,https://insight.olydor.app,https://arena.olydor.app,http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003

# Intégration GitHub Issues pour POST /api/reports
GITHUB_TOKEN=ghp_xxxxxxxxxxxx
GITHUB_REPO_OWNER=ton_compte_ou_orga
GITHUB_REPO_NAME=ton_depot
RATE_LIMIT_MAX_REPORTS_PER_HOUR=5

# --- Applications Front-End Nuxt 3 (apps/web, apps/insight, apps/arena) ---
NUXT_PUBLIC_API_URL=http://localhost:3000
NUXT_PUBLIC_WEB_URL=http://localhost:3001
NUXT_PUBLIC_INSIGHT_URL=http://localhost:3002
NUXT_PUBLIC_ARENA_URL=http://localhost:3003
