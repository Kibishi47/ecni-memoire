# Fournisseur LLM : 'local' (Apple Silicon local) ou 'lm_studio' (serveur distant/local LM Studio)
LLM_PROVIDER=local

# ==============================================================================
# PIPELINE & MODES DE TRAVAIL (LOCAL)
# ==============================================================================

# Mode de travail du compilateur :
# - 'single'   : Mode 1 (IA direct -> JSON en 1 seule passe)
# - 'two_pass' : Mode 2 (Double passe : 1. Raisonnement règles -> 2. Codage JSON)
PIPELINE_MODE=two_pass

# Niveau de puissance / empreinte mémoire :
# - 'soft'    (défaut) : Modèles légers sécurisés (~7-8 Go RAM), idéal en journée avec apps ouvertes
# - 'intense'          : Modèles haute précision (~14-18 Go RAM), mode nuit / session AFK dédiée
INTENSITY_MODE=soft

# Optimisation locale Apple Silicon :
# - 'mlx'       : Modèles safetensors natifs Apple Silicon via mlx-lm (recommandé)
# - 'llama_cpp' : Modèles GGUF Apple Metal via llama-cpp-python
LOCAL_BACKEND=mlx

# Phase par défaut en mode two_pass : 'all' (les deux passes), 'reason' (passe 1), 'code' (passe 2)
PIPELINE_PHASE=all

# Gestion des erreurs : continuer sur la carte suivante en cas d'échec
CONTINUE_ON_ERROR=false

# ==============================================================================
# SÉLECTION DES MODÈLES (Laisser vide pour résolution automatique via la matrice)
# ==============================================================================

# Modèle général (Mode 1 ou override global) :
# Matrice auto par défaut :
# - mlx soft    : mlx-community/gemma-4-26b-a4b-it-4bit
# - mlx intense : mlx-community/gemma-4-26b-a4b-it-4bit
# - gguf soft   : bartowski/Qwen2.5-Coder-14B-Instruct-GGUF
# - gguf intense: bartowski/Qwen2.5-Coder-32B-Instruct-GGUF
LLM_MODEL=

# Overrides spécifiques optionnels pour le Mode 2 (Two-Pass) :
# Passe 1 (Raisonnement - enable_thinking=True) :
# - mlx soft/intense : mlx-community/gemma-4-26b-a4b-it-4bit
# - gguf             : bartowski/DeepSeek-R1-Distill-Qwen-14B-GGUF
REASONING_MODEL=

# Passe 2 (Codage JSON - enable_thinking=False) :
# - mlx soft/intense : mlx-community/gemma-4-26b-a4b-it-4bit
# - gguf soft        : bartowski/Qwen2.5-Coder-7B-Instruct-GGUF
# - gguf intense     : bartowski/Qwen2.5-Coder-14B-Instruct-GGUF
CODING_MODEL=

# ==============================================================================
# OPTIONS DE RÉFLEXION / SAMPLING / BATCHING MLX
# ==============================================================================
# Batching continu MLX (nombre de cartes générées simultanément)
# Défaut 2 sécurisé pour Mac 24 Go RAM ; passer à 4 en exécution nocturne dédiée
MLX_BATCH_SIZE=2

# Budget max de tokens & sampling officiel Google Gemma 4 pour la Passe 1
REASONING_MAX_TOKENS=8192
REASONING_TEMPERATURE=1.0
REASONING_TOP_P=0.95
REASONING_TOP_K=64

# Options de thinking (LM Studio / llama.cpp ; en MLX Passe 1 thinking reste toujours actif)
# 'null' pour désactiver, ou 'low', 'medium', 'high', ou nombre de tokens
LM_STUDIO_THINKING=
LM_STUDIO_DISABLE_THINKING=false

# ==============================================================================
# LM STUDIO (Optionnel - Uniquement si LLM_PROVIDER=lm_studio)
# ==============================================================================
LM_STUDIO_PARALLEL=1
LM_STUDIO_HOST=
LM_STUDIO_PORT=1234
LM_STUDIO_BASE_URL=

# ==============================================================================
# TCGDEX & HUGGING FACE
# ==============================================================================
TCGDEX_PROVIDER=sdk
HF_TOKEN=
