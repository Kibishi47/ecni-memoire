# ==============================================================================
# Pokémon TCG Card Compiler — Fichier de Configuration d'Environnement (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fournisseur d'Inférence LLM
# ------------------------------------------------------------------------------
# Choix du moteur d'inférence :
# - 'local'     : Inférence locale Apple Metal (llama-cpp-python, Qwen3-14B)
# - 'lm_studio' : Inférence déportée sur LM Studio (machine distante SSH ou serveur local)
LLM_PROVIDER=local

# ------------------------------------------------------------------------------
# 2. Configuration LM Studio (Connexion Directe par IP Publique & Port)
# ------------------------------------------------------------------------------
# Adresse IP publique ou nom d'hôte du serveur LM Studio (ex: 192.168.1.50)
# Laissez vide pour une exécution sur localhost (127.0.0.1)
LM_STUDIO_HOST=

# Port HTTP sur lequel le serveur LM Studio écoute (défaut: 1234)
LM_STUDIO_PORT=1234

# (Alternative) URL REST complète directe (ex: http://192.168.1.50:1234/v1)
# LM_STUDIO_BASE_URL=http://192.168.1.50:1234/v1

# Modèle d'inférence (optionnel) :
# - Laissez VIDE pour utiliser automatiquement le modèle actuellement chargé dans LM Studio (recommandé)
# - Ou renseignez un nom précis (ex: 'lmstudio-community/Qwen3.8-27B-GGUF', 'qwen3.8-27b') pour vérifier qu'il est actif
LM_STUDIO_MODEL=

# Désactivation du mode réflexion / thinking pour les modèles raisonnants (ex: DeepSeek-R1, Qwen, QwQ) :
# - 'true'  : Désactive l'émission des balises <think> (réduit la latence et économise les tokens)
# - 'false' : Conserve le comportement par défaut du modèle (défaut)
LM_STUDIO_DISABLE_THINKING=false

# ------------------------------------------------------------------------------
# 3. Configuration Tunnel SSH (Optionnel — requis uniquement si le port 1234 n'est pas public)
# ------------------------------------------------------------------------------
# Si le serveur LM Studio est accessible directement via son IP publique, laissez ce bloc désactivé !
LM_STUDIO_USE_TUNNEL=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_PASSWORD=
LM_STUDIO_LOCAL_PORT=12345

# ------------------------------------------------------------------------------
# 4. Fournisseur de Données TCGdex
# ------------------------------------------------------------------------------
# Fournisseur d'accès aux cartes TCGdex :
# - 'sdk'  : SDK Python officiel tcgdex-sdk (défaut, recommandé)
# - 'rest' : API HTTP directe via httpx
TCGDEX_PROVIDER=sdk

# ------------------------------------------------------------------------------
# 5. Téléchargement Hugging Face (uniquement pour le provider 'local')
# ------------------------------------------------------------------------------
# Jeton d'authentification Hugging Face (HF_TOKEN) pour accélérer le téléchargement
# des modèles GGUF locaux (évite les limites de taux anonymes de HF)
HF_TOKEN=
