# ==============================================================================
# Pokémon TCG Card Compiler — Fichier de Configuration d'Environnement (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fournisseur d'Inférence LLM
# ------------------------------------------------------------------------------
# Choix du fournisseur :
# - 'local'     : Inférence en mémoire sur la machine locale via Apple Metal (llama-cpp-python)
# - 'lm_studio' : Inférence déportée sur LM Studio (machine distante via SSH ou serveur local)
LLM_PROVIDER=local

# ------------------------------------------------------------------------------
# 2. Configuration SSH pour Machine Distante (si LLM_PROVIDER=lm_studio)
# ------------------------------------------------------------------------------
# Adresse IP ou nom d'hôte de la machine distante hébergeant LM Studio
SSH_HOST=
# Port SSH du serveur distant (défaut: 22)
SSH_PORT=22
# Utilisateur SSH (ex: ubuntu, emmanuel)
SSH_USER=
# Chemin vers la clé privée SSH locale (ex: ~/.ssh/id_rsa, ~/.ssh/id_ed25519)
SSH_KEY_PATH=
# Mot de passe SSH (si connexion sans clé publique ou via mot de passe)
SSH_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Configuration LM Studio & CLI (`lms`)
# ------------------------------------------------------------------------------
# Port sur lequel le serveur LM Studio écoute sur la machine distante (défaut: 1234)
LM_STUDIO_PORT=1234
# Port TCP local utilisé pour le tunnel SSH (défaut: 12345 pour éviter tout conflit avec un port 1234 local)
LM_STUDIO_LOCAL_PORT=12345
# Établit automatiquement un tunnel SSH sécurisé transférant les requêtes locales vers la machine distante
LM_STUDIO_USE_TUNNEL=true
# Nom ou identifiant du modèle chargé dans LM Studio
# Par défaut sur machine distante : 'Qwen3.8-27B' en mode normal (--tier qwen3)
# Autres options possibles : Qwen3-30B-A3B (--tier max), Qwen2.5-Coder-7B-Instruct (--tier fast)
# Laissez vide pour utiliser les modèles recommandés par défaut ou auto-détecter le modèle actif dans LM Studio
LM_STUDIO_MODEL=Qwen3.8-27B
# Commande ou chemin vers l'exécutable LM Studio CLI sur la machine distante (défaut: lms)
LM_STUDIO_CLI_PATH=lms
# Démarre automatiquement le serveur et charge le modèle via `lms` si non démarré (true/false)
LM_STUDIO_AUTO_START=true

# ------------------------------------------------------------------------------
# 4. Téléchargement Hugging Face (uniquement pour le provider 'local')
# ------------------------------------------------------------------------------
# Jeton d'authentification Hugging Face (optionnel) pour accélérer le téléchargement des modèles GGUF
HF_TOKEN=
