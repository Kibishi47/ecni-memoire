LLM_PROVIDER=local

# Optimisation locale uniquement : 'mlx' (Apple Silicon natif) ou 'llama_cpp' (GGUF Metal)
LOCAL_BACKEND=mlx

CONTINUE_ON_ERROR=false

# Modèle d'inférence (par défaut si vide : 'mlx-community/Qwen3.8-27B-4bit' en MLX, auto-détection en LM Studio)
LLM_MODEL=

# Mode réflexion : 'low', 'medium', 'high', 'null' ou nombre de tokens
LM_STUDIO_THINKING=
LM_STUDIO_DISABLE_THINKING=false

# LM Studio uniquement
LM_STUDIO_PARALLEL=1
LM_STUDIO_HOST=
LM_STUDIO_PORT=1234
LM_STUDIO_BASE_URL=

# Tunnel SSH (LM Studio distant)
LM_STUDIO_USE_TUNNEL=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_PASSWORD=
LM_STUDIO_LOCAL_PORT=12345

TCGDEX_PROVIDER=sdk
HF_TOKEN=
