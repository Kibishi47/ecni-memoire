# ==============================================================================
# Pokémon TCG Card Compiler — Fichier de Configuration d'Environnement (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Fournisseur d'Inférence LLM
# ------------------------------------------------------------------------------
# Choix du moteur d'inférence :
# - 'local'     : Inférence locale Apple Metal (llama-cpp-python, Qwen3-14B)
# - 'lm_studio' : Inférence déportée sur LM Studio (machine distante SSH ou serveur local)
LLM_PROVIDER=local

# ------------------------------------------------------------------------------
# 2. Configuration Machine Distante & SSH (requis si LLM_PROVIDER=lm_studio)
# ------------------------------------------------------------------------------
# Adresse IP ou nom d'hôte de la machine distante équipée de GPU (ex: 192.168.1.50)
SSH_HOST=

# Port SSH du serveur distant (défaut: 22)
SSH_PORT=22

# Utilisateur SSH sur la machine distante (ex: ubuntu, emmanuel, debian)
SSH_USER=

# Chemin vers la clé privée SSH locale (ex: ~/.ssh/id_rsa, ~/.ssh/id_ed25519)
# Laissez vide si vous utilisez une connexion par mot de passe ou l'agent SSH standard
SSH_KEY_PATH=

# Mot de passe SSH (si connexion sans clé publique ou protégée par mot de passe)
# Laissez vide si vous utilisez une clé SSH
SSH_PASSWORD=

# ------------------------------------------------------------------------------
# 3. Configuration LM Studio & CLI (`lms`)
# ------------------------------------------------------------------------------
# Port HTTP sur lequel le serveur LM Studio écoute sur la machine distante (défaut: 1234)
LM_STUDIO_PORT=1234

# Port TCP local utilisé pour le tunnel SSH sécurisé (défaut: 12345)
# Permet d'éviter les conflits si un LM Studio local tourne déjà sur 1234
LM_STUDIO_LOCAL_PORT=12345

# Établit automatiquement un tunnel SSH sécurisé local -> distant (true/false)
LM_STUDIO_USE_TUNNEL=true

# Modèle d'inférence chargé dans LM Studio :
# - Par défaut sur machine distante : 'qwen2.5-coder-32b-instruct' en mode normal (--tier qwen3 / standard)
# - Autres modèles recommandés selon la VRAM :
#     • 'qwen2.5-coder-32b-instruct' (32B pour GPU 24 Go+, haute fidélité)
#     • 'qwen2.5-coder-14b-instruct' (14B pour GPU 12-16 Go)
#     • 'qwen2.5-coder-7b-instruct'  (7B pour GPU 8 Go ou mode rapide : --tier fast)
# Laissez vide pour auto-détecter automatiquement le modèle présent sur la machine distante.
LM_STUDIO_MODEL=qwen2.5-coder-32b-instruct

# Commande ou chemin vers l'exécutable LM Studio CLI sur la machine distante
# Exemples : 'lms', '~/.cache/lm-studio/bin/lms', '/usr/local/bin/lms'
LM_STUDIO_CLI_PATH=lms

# Démarre automatiquement le serveur et charge le modèle via `lms` si non actif (true/false)
LM_STUDIO_AUTO_START=true

# ------------------------------------------------------------------------------
# 4. Fournisseur de Données TCGdex
# ------------------------------------------------------------------------------
# Fournisseur d'accès aux cartes TCGdex :
# - 'sdk'  : SDK Python officiel tcgdex-sdk (défaut, recommandé)
# - 'rest' : API HTTP directe via httpx
TCGDEX_PROVIDER=sdk

# ------------------------------------------------------------------------------
# 5. Téléchargement Hugging Face (uniquement pour le provider 'local')
# ------------------------------------------------------------------------------
# Jeton d'authentification Hugging Face (HF_TOKEN) pour accélérer le téléchargement
# des modèles GGUF locaux (évite les limites de taux anonymes de HF)
HF_TOKEN=
