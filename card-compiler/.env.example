# ==============================================================================
# Pokémon TCG Card Compiler — Fichier de Configuration d'Environnement (.env)
# ==============================================================================
# Ce fichier configure le pipeline de compilation pour les deux modes d'exécution :
#   1. Mode LM Studio (déporté via réseau local, IP publique ou tunnel SSH sécurisé)
#   2. Mode Local (inférence Apple Metal sur Mac via llama-cpp-python)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FOURNISSEUR D'INFÉRENCE & GESTION DES ERREURS
# ------------------------------------------------------------------------------
# Moteur d'inférence LLM :
# - 'lm_studio' : Inférence sur serveur LM Studio (distant SSH ou local)
# - 'local'     : Inférence locale Apple Metal M4 (llama.cpp)
LLM_PROVIDER=local

# Gestion des erreurs de compilation :
# - false : Arrêt immédiat dès la première erreur (défaut, idéal pour debug)
# - true  : Ignore l'erreur, passe à la carte suivante et récapitule à la fin
CONTINUE_ON_ERROR=false

# ------------------------------------------------------------------------------
# 2. SÉLECTION DU MODÈLE (COMMUN LOCAL & LM STUDIO)
# ------------------------------------------------------------------------------
# Modèle d'inférence LLM à utiliser (valable pour les 2 modes) :
#
# • En mode LM Studio :
#   - Laissez VIDE pour auto-détecter le modèle actif chargé sur le serveur (recommandé)
#   - Ou indiquez l'identifiant exact (ex: 'qwen2.5-coder-32b-instruct')
#
# • En mode Local (Apple Metal llama.cpp) :
#   - Laissez VIDE pour utiliser le modèle par défaut (Qwen/Qwen3-14B-GGUF)
#   - Ou chemin local vers un fichier .gguf (ex: '/chemin/vers/mon-modele.gguf')
#   - Ou repo Hugging Face / fichier (ex: 'Qwen/Qwen3-14B-GGUF/Qwen3-14B-Q6_K.gguf'
#     ou 'bartowski/Qwen2.5-Coder-32B-Instruct-GGUF:qwen2.5-coder-32b-instruct-q4_k_m.gguf')
LLM_MODEL=

# ------------------------------------------------------------------------------
# 3. MODE THINKING / RAISONNEMENT (REASONING EFFORT)
# ------------------------------------------------------------------------------
# Contrôle du raisonnement interne (<think>...</think>) des modèles récents
# (Qwen 2.5 / 3, DeepSeek-R1, QwQ, etc.) :
#
# • LM_STUDIO_THINKING :
#   - 'null'   : Désactive totalement le thinking
#   - 'low'    : Effort de réflexion réduit (génération rapide)
#   - 'medium' : Effort de réflexion standard
#   - 'high'   : Effort de réflexion maximal (cartes complexes)
#   - '1024'   : Budget fixe en tokens (ex: 512, 1024, 2048)
#   - Laissez VIDE : Comportement par défaut du modèle/serveur
#
# • LM_STUDIO_DISABLE_THINKING (Raccourci booléen) :
#   - false : Conserve le thinking configuré ci-dessus (défaut)
#   - true  : Force la désactivation totale (équivaut à 'null', transmet boolean
#             false pour les modèles booléens, reasoning_effort='none' / 0 token)
LM_STUDIO_THINKING=
LM_STUDIO_DISABLE_THINKING=false

# ------------------------------------------------------------------------------
# 4. PARALLÉLISATION & CONCURRENCE MULTI-SLOTS (LM STUDIO)
# ------------------------------------------------------------------------------
# Nombre de cartes compilées simultanément en parallèle (LM Studio uniquement) :
# - 1 : Mode séquentiel standard (défaut)
# - 2, 4, etc. : Compilation concurrente multi-slots avec suivi terminal en temps réel
# Note : Veillez à charger le modèle sur votre serveur avec un contexte suffisant :
#   ex: `lms load <model> --gpu 0.7 --context-length 16384 --parallel 4`
LM_STUDIO_PARALLEL=1

# ------------------------------------------------------------------------------
# 5. CONNEXION LM STUDIO (DIRECTE OU VIA TUNNEL SSH)
# ------------------------------------------------------------------------------
# A. Connexion Directe (réseau local ou IP publique) :
# Adresse IP ou hostname du serveur LM Studio (laissez vide pour 127.0.0.1)
LM_STUDIO_HOST=
# Port HTTP du serveur LM Studio (défaut: 1234)
LM_STUDIO_PORT=1234
# (Alternative) URL REST complète directe (ex: http://192.168.1.50:1234/v1)
LM_STUDIO_BASE_URL=

# B. Tunnel SSH Sécurisé (requis si le port 1234 n'est pas accessible directement) :
# Active l'ouverture automatique du tunnel SSH (transfère 127.0.0.1:12345 vers le serveur)
LM_STUDIO_USE_TUNNEL=false
# Hôte / IP de la machine distante SSH
SSH_HOST=
# Port SSH (défaut: 22)
SSH_PORT=22
# Utilisateur SSH
SSH_USER=
# Chemin vers la clé privée SSH (ex: ~/.ssh/id_ed25519 ou ~/.ssh/id_rsa)
SSH_KEY_PATH=
# Mot de passe SSH (optionnel si clé publique utilisée ou si saisie interactive)
SSH_PASSWORD=
# Port local réservé pour le tunnel SSH (défaut: 12345)
LM_STUDIO_LOCAL_PORT=12345

# ------------------------------------------------------------------------------
# 6. FOURNISSEUR TCGDEX & CACHE HUGGING FACE
# ------------------------------------------------------------------------------
# Fournisseur d'accès aux cartes TCGdex :
# - 'sdk'  : SDK Python officiel tcgdex-sdk (défaut, recommandé)
# - 'rest' : API HTTP directe via httpx
TCGDEX_PROVIDER=sdk

# Jeton Hugging Face (optionnel, uniquement pour le mode local) :
# Accélère le téléchargement des modèles GGUF et évite les limites de taux HF
HF_TOKEN=
