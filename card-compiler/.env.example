# Moteur d'inférence LLM : 'lm_studio' ou 'local'
LLM_PROVIDER=local

# Continuer la compilation en cas d'erreur sur une carte (true / false)
CONTINUE_ON_ERROR=false

# Modèle d'inférence (nom LM Studio, chemin local .gguf, ou repo Hugging Face)
LLM_MODEL=

# Niveau de réflexion : 'low', 'medium', 'high', 'null' ou nombre de tokens
LM_STUDIO_THINKING=

# Désactiver le thinking (true / false)
LM_STUDIO_DISABLE_THINKING=false

# Nombre de slots parallèles (LM Studio)
LM_STUDIO_PARALLEL=1

# Connexion directe LM Studio
LM_STUDIO_HOST=
LM_STUDIO_PORT=1234
LM_STUDIO_BASE_URL=

# Tunnel SSH (si port 1234 non accessible publiquement)
LM_STUDIO_USE_TUNNEL=false
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_KEY_PATH=
SSH_PASSWORD=
LM_STUDIO_LOCAL_PORT=12345

# Fournisseur de données TCGdex : 'sdk' ou 'rest'
TCGDEX_PROVIDER=sdk

# Jeton Hugging Face (optionnel, pour téléchargement local)
HF_TOKEN=
