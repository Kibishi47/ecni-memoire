{
  "name": "meta-oracle-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "Écosystème monorepo Meta Oracle — Moteur de simulation Pokémon TCG, API TypeScript, Hub SEO, Simulateur & Arène IA",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build && pnpm -r --filter './apps/*' build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev:api": "pnpm --filter @meta-oracle/api dev",
    "dev:web": "pnpm --filter @meta-oracle/web dev",
    "dev:sim": "pnpm --filter @meta-oracle/sim dev",
    "dev:arena": "pnpm --filter @meta-oracle/arena dev"
  }
}
