{
  "name": "pokemon-tcg-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend REST API for Pokémon TCG simulator (PostgreSQL, card catalog, meta decks, bug reports & GitHub integration)",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "seed": "npm run seed:cards && npm run seed:meta-decks",
    "seed:prod": "npm run seed:cards:prod && npm run seed:meta-decks:prod",
    "seed:cards": "tsx src/scripts/seedCards.ts",
    "seed:cards:prod": "node dist/scripts/seedCards.js",
    "seed:meta-decks": "tsx src/scripts/seedMetaDecks.ts",
    "seed:meta-decks:prod": "node dist/scripts/seedMetaDecks.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/compress": "^9.3.0",
    "@fastify/cors": "^11.0.1",
    "@octokit/rest": "^21.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.2",
    "pg": "^8.15.6",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/pg": "^8.15.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
